{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron?job=daily",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/wattworthsolar_platform.html"
    },
    {
      "source": "/partner",
      "destination": "/partner/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(partner|admin)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}